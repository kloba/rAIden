# rAIden Console settings. For systemd: /etc/raiden/console.env (root:raiden 0640). For docker compose: .env next to
# docker-compose.yml. Every setting has a default; only the secret key matters in production.

# Signs sessions and encrypts the stored database passwords and AI keys. Generate once and keep it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the console creates data_dir/secret.key (0600) on first start.
RAIDEN_SECRET_KEY=

# Where the console keeps its state (SQLite by default) and the generated key.
RAIDEN_CONSOLE_DATA=/var/lib/raiden-console
# A PostgreSQL state store instead of SQLite (backed up and restored with the rest of your databases). Run one console
# per state store: the console schedules collection, incidents and routines itself.
#RAIDEN_CONSOLE_DB=postgresql+psycopg://raiden:PASSWORD@state-db.internal:5432/raiden
# docker compose only: the password of the bundled state store
#RAIDEN_STATE_PASSWORD=

RAIDEN_CONSOLE_HOST=127.0.0.1
RAIDEN_CONSOLE_PORT=8080
# The public URL (links in notifications, the host agent's RAIDEN_CONSOLE_URL). https:// also marks cookies Secure.
RAIDEN_BASE_URL=https://raiden.example.com
#RAIDEN_SESSION_HOURS=12
# AI sessions that may run at once (incidents and routines; chat is not counted)
#RAIDEN_MAX_AI_SESSIONS=3
#RAIDEN_LOG_LEVEL=info
# json: one object per line for a log pipeline (Loki, Elastic, Azure Monitor Logs ...)
#RAIDEN_LOG_FORMAT=json

# Prometheus scrape endpoint (/api/v1/prometheus) is off unless a bearer token is set:
#RAIDEN_METRICS_TOKEN=

# Azure Monitor platform metrics (servers with an Azure resource ID) use DefaultAzureCredential: a managed identity
# with the Monitoring Reader role, or AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET.
