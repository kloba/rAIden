# /etc/raiden/raiden.env  (root:root 0640)  - no secrets: the VM's managed identity authenticates to Azure OpenAI.
RAIDEN_AOAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
RAIDEN_AOAI_DEPLOYMENT=gpt-5.5
# the GPT-6 family (e.g. gpt-6.1-sol) is spoken to through the Responses API; chosen automatically for deployments named gpt-6*
# RAIDEN_AOAI_API=responses
RAIDEN_AOAI_API_VERSION=2025-04-01-preview
RAIDEN_REASONING_EFFORT=medium
# incident policy (defaults shown)
#RAIDEN_QUIET_S=8
#RAIDEN_MAX_WAIT_S=30
#RAIDEN_MAX_TURNS=60
#RAIDEN_INCIDENT_TIMEOUT_S=900
#RAIDEN_RESTART_BUDGET=6
#RAIDEN_EVOLVE=1
#RAIDEN_PATROL_INTERVAL_S=1800
#RAIDEN_PATROL_MIN_GAP_S=20   # patrol also runs right after a config reload is seen in the log, at most this often
# link to the rAIden console: the server's Settings tab shows these three lines when you create an agent token
#RAIDEN_CONSOLE_URL=https://raiden.example.com
#RAIDEN_CONSOLE_TOKEN=
#RAIDEN_SERVER_ID=
